# Factory Pulse — Configuración de Entorno Local

DATABASE_URL=sqlite+aiosqlite:///./factory_pulse.db
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0

# MQTT Broker (Opcional - por defecto desactivado para arranque autónomo)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=factory_pulse
MQTT_USERNAME=
MQTT_PASSWORD=

# Modo de Arranque
SEED_ON_STARTUP=true
SIMULATOR_SPEED=1.0
START_MODE=demo

# Vite (definir en la terminal que ejecuta npm run dev si cambia algún puerto)
FP_API_TARGET=http://localhost:8000
FP_VISION_TARGET=http://localhost:8001
