# Factory Pulse — Configuración de Entorno Local

DATABASE_URL=sqlite+aiosqlite:///./factory_pulse.db
API_V1_STR=/api
PORT=8000
HOST=0.0.0.0

# MQTT Broker (Opcional - por defecto desactivado para arranque autónomo)
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=factory_pulse
MQTT_USERNAME=
MQTT_PASSWORD=

# Modo de Arranque
SEED_ON_STARTUP=true
SIMULATOR_SPEED=1.0
START_MODE=demo

# Opcional: exige esta clave en X-Factory-Pulse-Key para /api/rfid/events.
# No la guardes en firmware público ni en el repositorio.
RFID_INGEST_TOKEN=

# Cámaras. El backend detecta automáticamente .venv-vision; define
# VISION_PYTHON sólo si el intérprete de visión está en otra ubicación.
VISION_PYTHON=
VISION_BACKEND_URL=http://127.0.0.1:8000
VISION_PORT_START=8101
VISION_PORT_END=8199
# Opcional: llave Fernet o frase privada estable para cifrar contraseñas.
# Si se deja vacía, Factory Pulse crea una llave local ignorada por Git.
CAMERA_SECRET_KEY=
CAMERA_KEY_FILE=.factory_pulse_camera.key

# Vite (definir en la terminal que ejecuta npm run dev si cambia el backend)
FP_API_TARGET=http://localhost:8000
